{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch HTTP server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go",
            "args": ["api-server", "8080"],
            "buildFlags": "-tags=sqlite,sqlite_fts5"
        },
        {
            "name": "Import data",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go",
            "args": ["import", "./data/backup"],
            "buildFlags": "-tags=sqlite,sqlite_fts5"
        },
        {
            "name": "Generate sitemap",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go",
            "args": [
                "sitemap",
                "https://www.destructuring-bind.org/gps-routes/"
            ],
            "buildFlags": "-tags=sqlite,sqlite_fts5"
        }
    ]
}
